# Default-deny public source tree. Local research and game data never enter Git.
/*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/Compiler.ps1
!/LICENSE
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY.md
!/src/
!/docs/
!/tools/
!/references/
!/data/
!/outputs/
!/.github/
/outputs/*
!/outputs/CTW-Rust/
/outputs/CTW-Rust/*
!/outputs/CTW-Rust/src/
!/outputs/CTW-Rust/*.md
!/outputs/CTW-Rust/*.toml
!/outputs/CTW-Rust/Cargo.lock
!/outputs/CTW-Rust/LICENSE
!/outputs/CTW-Rust/*.ps1
!/outputs/CTW-Rust/*.cmd
/data/*
!/data/README.md
!/data/tables/
/data/tables/*
!/data/tables/README.md
/references/*
!/references/*.md
# Asset/build exclusions also apply inside otherwise tracked directories.
**/target/
**/__pycache__/
**/node_modules/
*.iso
*.cso
*.nds
*.apk
*.elf
*.exe
*.dll
*.pdb
*.o
*.a
*.rlib
*.rmeta
*.bin
*.pak
*.wad
*.toc
*.bmp
*.png
*.jpg
*.jpeg
*.mp4
*.mp3
*.wav
*.zip
*.7z
*.rgba*
*.log
.env
.env.*
*.pem
*.key
*.local.*
